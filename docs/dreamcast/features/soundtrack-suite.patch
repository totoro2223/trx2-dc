+    Music_Stop();
+    SHOULD(Music_Init());
+    Music_SetVolume(g_Config.audio.music_volume);
+    if (looped >= 0) {
+        Music_PlayBySlot(looped, MPM_LOOP);
+    }
+    if (playing >= 0) {
+        Music_PlayBySlot(playing, MPM_ONCE);
+    }
+}
